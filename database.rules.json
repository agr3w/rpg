{
  "rules": {
    ".read": false,
    ".write": false,

    "system": {
      "metadata": {
        // Todo mundo pode ler a versão e anúncios
        ".read": true,
        // SÓ VOCÊ pode alterar
        ".write": "auth != null && auth.uid === 'hKYEhI9JIEPOS2RSON7tsviLzjV2'"
      },
      "reports": {
        // Leitura para você (admin) e quem enviou
        ".read": "auth != null",
        "$reportId": {
          // Qualquer usuário logado pode criar um report; admin pode editar/excluir
          ".write": "auth != null"
        }
      }
    },

    "reports": {
      ".read": "auth != null",
      "$reportId": {
        ".write": "auth != null"
      }
    },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "campaigns": {
          "$campaignId": {
            "sessionLogs": {
              ".indexOn": ["createdAt"]
            }
          }
        }
      }
    },

    "preferences": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "themeMode": {
          ".validate": "newData.isString() && (newData.val() === 'system' || newData.val() === 'light' || newData.val() === 'dark')"
        },
        "themeStyle": {
          ".validate": "newData.isString() && (newData.val() === 'parchment' || newData.val() === 'default')"
        },
        "reduceMotion": {
          ".validate": "newData.isBoolean()"
        },
        "pageTransition": {
          ".validate": "newData.isString() && (newData.val() === 'dragon' || newData.val() === 'simple')"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": true
        }
      }
    },

    "books": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "musicas": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "notes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "folders": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "fichas": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".indexOn": ["id", "createdAt"]
      }
    },

    "maps": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "public_assets": {
      ".read": true,
      ".write": false
    },

    "user_assets": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },

    "userCampaigns": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },

    "campaignMembers": {
      "$campaignId": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'dm' || root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'co-dm')",
          ".write": "auth != null && ((!data.parent().exists() && auth.uid === $uid && newData.child('role').val() === 'dm') || root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'dm' || root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'co-dm')"
        }
      }
    },

    "campaigns": {
      "$campaignId": {
        ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",

        "meta": {
          ".write": "auth != null && (root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'dm' || root.child('campaignMembers').child($campaignId).child(auth.uid).child('role').val() === 'co-dm')"
        },

        "sessionLogs": {
          ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",
          ".indexOn": ["createdAt"],
          "$sessionId": {
            ".write": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()"
          }
        },

        "npcs": {
          ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",
          "$npcId": {
            ".write": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()"
          }
        },

        "npcIndex": {
          ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",
          "$key": {
            ".write": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()"
          }
        },

        "quests": {
          ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",
          "$questId": {
            ".write": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()"
          }
        },

        "questIndex": {
          ".read": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()",
          "$key": {
            ".write": "auth != null && root.child('campaignMembers').child($campaignId).child(auth.uid).exists()"
          }
        }
      }
    },

    "vtt_sessions": {
      "$sessionId": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('dmId').val() === auth.uid)"
        },
        "state": {
          ".write": "auth != null"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('vtt_sessions').child($sessionId).child('meta').child('dmId').val() === auth.uid)"
          }
        },
        "kicked": {
          ".write": "auth != null && root.child('vtt_sessions').child($sessionId).child('meta').child('dmId').val() === auth.uid"
        }
      }
    }
  }
}
